# Copy to ".backup.env" on the server, then: chmod 600 .backup.env      (never commit it; the website container does not read it)
# Long passphrase used to encrypt backups. ALSO keep a copy in your password manager: without it backups cannot be restored.
BACKUP_PASSPHRASE=
# Optional off-site copy through rclone (set up once with `rclone config`), e.g. b2:sportiq-backups
BACKUP_RCLONE_REMOTE=
